# 이 파일을 복사해 .env 로 만든 뒤 실제 값을 채우세요. (.env 는 커밋 금지)
# cp .env.example .env

# DB (PostgreSQL + PostGIS)
DATABASE_URL=
# DB 접속 시도 제한(초, 1~60). health 실행에는 DB가 필요하지 않습니다.
DATABASE_CONNECT_TIMEOUT=5

# 공공데이터포털
DATA_GO_KR_SERVICE_KEY=

# 카카오 로컬 API
KAKAO_REST_API_KEY=
# 카카오 주소 검색 요청 제한(초, 1~10)
KAKAO_REQUEST_TIMEOUT=5

# 도로명주소(juso.go.kr)
JUSO_SEARCH_KEY=
JUSO_COORD_KEY=

# 생성형 AI (무료 모델 사용)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# 요청 1회 제한(초, 1~60)과 재시도 대기를 포함한 전체 시간 예산(초, 1~120)
LLM_REQUEST_TIMEOUT=10
LLM_TIME_BUDGET=20
# 429·일시 장애 재시도 횟수(0~5)와 지수 백오프 기준·상한(초)
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE=1
LLM_BACKOFF_MAX=8
# 응답 최대 토큰(1~65536)
LLM_MAX_OUTPUT_TOKENS=2048
# 프로세스 내 분당·일일 요청 한도. 프로젝트 계정의 실제 한도를 확인해 설정하고, 비우면 제한하지 않습니다.
LLM_REQUESTS_PER_MINUTE=
LLM_REQUESTS_PER_DAY=

# 서버 설정
APP_ENV=local
# 쉼표로 구분한 origin만 지정합니다. 경로·와일드카드는 허용하지 않습니다.
CORS_ORIGINS=http://localhost:5173
